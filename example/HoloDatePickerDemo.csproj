<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../dotnative.local.props" Condition="Exists('../dotnative.local.props')" />
  <PropertyGroup>
    <DotNativeSourceRoot Condition="'$(DotNativeSourceRoot)' == '' and Exists('../../dotNative/src/DotNative/DotNative.csproj')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../dotNative'))</DotNativeSourceRoot>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(DotNativeSourceRoot)/src/DotNative/DotNative.csproj')">
    <ProjectReference Include="$(DotNativeSourceRoot)/src/DotNative/DotNative.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <PublishAotUsingRuntimePack Condition="'$(RuntimeIdentifier)' != 'osx-arm64'"
      >true</PublishAotUsingRuntimePack>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''"
      >iossimulator-arm64</RuntimeIdentifier>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**/*.cs" Exclude="bin/**;obj/**;artifacts/**;Platform/**;.dotnative/**" />
    <PackageReference
      Condition="'$(DotNativeDevelopment)' != 'true' and !Exists('$(DotNativeSourceRoot)/src/DotNative/DotNative.csproj')"
      Include="DotNative.App"
      Version="0.1.0-preview.10"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DotNative.HoloDatePicker.csproj" />
  </ItemGroup>
</Project>
